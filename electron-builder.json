{
  "appId": "com.drastro.app",
  "productName": "Dr. Astro",
  "directories": {
    "output": "dist-electron"
  },
  "files": [
    "electron/**/*",
    "out/**/*"
  ],
  "win": {
    "target": "nsis",
    "icon": "public/icon-512.png"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Dr. Astro"
  },
  "mac": {
    "target": "dmg",
    "icon": "public/icon-512.png"
  },
  "linux": {
    "target": "AppImage",
    "icon": "public/icon-512.png"
  }
}
